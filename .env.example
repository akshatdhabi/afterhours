# Local Node server. No external database, API key, or account is required.
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/afterhours.sqlite
ROOM_TTL_HOURS=12
MAX_ROOMS=500
# Required only when NODE_ENV=production. Exact HTTPS origin, no trailing slash.
# APP_ORIGIN=https://your-game.example
# TRUST_PROXY=1  # Only behind exactly one trusted reverse proxy.

# Optional: Netlify front end -> Cloudflare Worker backend.
# Build-time PUBLIC URL, not a secret. Leave unset for all-Cloudflare hosting.
# VITE_API_URL=https://afterhours-game-show.YOUR-SUBDOMAIN.workers.dev
